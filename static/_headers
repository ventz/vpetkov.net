# Ventz Changes: Cloudflare Pages cache lifetimes (Lighthouse "efficient cache
# lifetimes"). Fingerprinted assets are immutable; un-fingerprinted statics get
# a day with revalidation; HTML stays default (CF respects build output freshness).

# Hugo pipes output — content-hashed filenames, safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static files without fingerprints — cache a day, revalidate in background
/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon-16x16.png
  Cache-Control: public, max-age=86400
/favicon-32x32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
