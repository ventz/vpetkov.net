+    padding: 0.4em;
 }
 
+/* Ventz Changes BEGIN: Floating TOC sidebar to the right of the post.
+   (a11y) Only where it fully fits — below 1360px it caused horizontal page
+   scrolling (WCAG 1.4.10); narrower viewports fall back to the in-flow TOC.
+   Sticky (not absolute) so it follows the reader down the post; floated out
+   of the flow so it doesn't push content; auto-opened by extend_footer.html. */
+@media screen and (min-width: 1360px) {
+    details.toc {
+        position: sticky;
+        float: right;
+        top: 24px;
+        width: 240px;
+        margin: 0 -270px 0 0;
+        font-size: 14px;
+        max-height: calc(100vh - 48px);
+        overflow-y: auto;
+        z-index: 1000;
+    }
+}
+/* Ventz Changes END */
+
 [data-theme="dark"] details.toc {
     background: var(--entry);
 }
