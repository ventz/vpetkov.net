+  </div>{{- /* Ventz Changes: end .entry-topline */}}
+  {{- if (ne (.Param "hideSummary") true) }}
+  <div class="entry-content">
+    {{- /* Ventz Changes: rich HTML preview (rendered .Summary). Headings are
+           rewritten to <p><strong> so card previews don't pollute the page's
+           heading outline (WCAG 1.3.1); other block elements (hr, pre) are tamed
+           by assets/css/extended/ventz-entry-preview.css. A div wrapper because
+           block children inside <p> break the parser. */}}
+    {{- $preview := replaceRE `(?s)<h[1-6][^>]*>(.*?)</h[1-6]>` `<p><strong>$1</strong></p>` (string .Summary) }}
+    {{- /* Ventz Changes: anchors are stripped from the preview (text kept). A card is
+           ONE target — click anywhere, get the post. A live link inside the teaser is a
+           second destination hidden in a surface readers already treat as a single
+           button, and it silently exits the site from a summary. The real link is in
+           the post itself. Link text is kept in <em class="preview-link"> so it still
+           stands out (italic) without being clickable. */}}
+    {{- $preview = replaceRE `<a\b[^>]*>` `<em class="preview-link">` $preview }}
+    {{- $preview = replaceRE `</a>` `</em>` $preview }}
