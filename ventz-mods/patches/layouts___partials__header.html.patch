+<a class="skip-link" href="#main-content">Skip to main content</a>
 <header class="header">
     <nav class="header-nav">
         <div class="logo">
@@ -19,10 +23,13 @@
                             {{- $img = $img.Resize "x30" }}
                         {{- end }}
                     {{- end }}
-                    <img src="{{ $img.Permalink }}" alt="" aria-label="logo"
+                    {{- /* Ventz Changes (a11y): dropped aria-label="logo" — ARIA labels are
