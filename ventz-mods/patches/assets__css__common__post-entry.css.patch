+/* Ventz Changes (a11y) BEGIN: on list cards only, the link lives on the title; its ::after
+   expands the hit area over the card while inner summary links/code stay clickable */
+.post-entry .entry-link {
+    position: static;
+    color: inherit;
+}
+
+.post-entry .entry-link::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    border-radius: var(--radius);
+    z-index: 0;
+}
+
+/* Ventz Changes (a11y): only interactive descendants rise above the hit area — plain
+   summary text still falls through, so the whole card keeps navigating on click */
+.entry-content a,
+.entry-content pre {
+    position: relative;
+    z-index: 1;
+}
+/* Ventz Changes END */
+
+/* Ventz Changes (a11y) BEGIN: honor reduced-motion for card lift and TOC expansion */
+@media (prefers-reduced-motion: reduce) {
+    .post-entry {
+        transition: none;
+    }
+
+    .post-entry:hover,
+    .post-entry:focus-within {
+        transform: none;
+    }
+
+    details::details-content {
+        transition: none;
+    }
+}
+/* Ventz Changes END */
+
 .entry-hint {
     color: var(--secondary);
 }
 
